  "observations": [
    { "id": "state" },
    { "id": "judgement" },
    { "id": "density", "unit": "kg/m³", "digits": 0 },
    { "id": "floating_depth", "unit": "m", "digits": 3 },
    { "id": "depth", "unit": "m", "digits": 3 },
    { "id": "buoyant", "unit": "N", "digits": 0 },
    { "id": "weight", "unit": "N", "digits": 0 },
    { "id": "net", "unit": "N", "digits": 0 },
