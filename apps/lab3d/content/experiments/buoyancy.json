    {
      "id": "volume",
      "type": "choice",
      "default": "big",
      "options": [
        { "id": "big", "label": "100 L", "volume": 0.1, "height": 0.5 },
        { "id": "small", "label": "50 L", "volume": 0.05, "height": 0.4 }
      ]
    }
  ],
  "actions": [
    { "id": "release", "style": "primary" },
