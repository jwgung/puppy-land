  "graph": {
    "x": { "unit": "s", "max": 10.0 },
    "y": { "unit": "m", "min_max": 0.5 },
    "series": [
      { "id": "depth", "color": "#ff7a1a", "style": "line" },
      { "id": "floating", "color": "#2d7cf6", "style": "line" }
    ]
  }
