    "answer": "sinks",
    "bridge_face": "happy",
    "stage": 1
  },
  "missions": {
    "judge_on": ["floating"],
    "miss_on": ["floating", "sunk", "staying"],
    "reveal_on": ["floating", "sunk", "staying"],
    "hidden_until_end": ["judgement", "density", "floating_depth"],
    "hidden_series_until_end": ["floating"],
    "stages": [
      {
        "conditions": {
          "volume": "small",
          "mass": { "max": 45.0 }
        },
        "say_face": "explain",
        "win_face": "happy",
        "miss_face": "thinking"
      },
      {
        "conditions": {
          "volume": "small",
          "mass": { "min": 80.0 }
        },
        "judge_on": ["sunk"],
        "miss_on": ["floating", "staying"],
        "say_face": "thinking",
        "win_face": "surprised",
        "miss_face": "thinking"
      },
      {
        "conditions": {
          "volume": "big",
          "mass": { "min": 80.0 }
        },
        "say_face": "explain",
        "win_face": "surprised",
        "miss_face": "thinking"
      }
    ]
  },
  "story": { "clue_face": "surprised", "map_clue_face": "explain" },
  "kid": {
    "intro_face": "explain",
    "card": "state",
    "say_face": "explain",
    "picks": {
      "mass": [
        { "value": 45.0, "picture": "weight", "size": 0.825 },
        { "value": 80.0, "picture": "weight", "size": 1.0 }
      ],
      "volume": [
        { "value": "big", "picture": "drum_big" },
        { "value": "small", "picture": "drum_small" }
      ]
    }
  },
  "note": {
    "numbers": [
      {
        "ids": ["weight"]
      },
      {
        "ids": ["buoyant"]
      },
      {
        "ids": ["depth"]
      },
      {
        "ids": ["floating_depth"]
      }
    ],
    "graph": false
  },
  "cast": {
    "dugi": {
      "at": [2.5, 3.0],
      "explain_on": ["floating", "sunk", "staying"],
      "delay_s": 0.6
    },
    "puppy": {
      "at": [-5.25, -9.25]
