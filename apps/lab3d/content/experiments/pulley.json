{
  "id": "pulley",
  "version": 1,
  "icon": "◉",
  "scene": "res://experiments/pulley/pulley.gd",
  "bench_id": "PU",
  "camera": {
    "target": [0.0, 2.3, 0.0],
    "distance": 10.0,
    "distance_range": [1.5, 24.0],
    "yaw_range_deg": [-100.0, 100.0],
    "pitch_range_deg": [-89.0, -2.0],
    "pan_radius": 6.0,
    "default_mode": "front",
    "views": {
      "front": {
        "yaw_deg": 0.0,
        "pitch_deg": -4.0,
        "distance": 12.0,
        "target": [0.0, 2.9, 0.0]
      },
      "three_quarter": { "yaw_deg": 24.0, "pitch_deg": -14.0 },
      "top": { "yaw_deg": 0.0, "pitch_deg": -89.0, "distance": 13.0 },
      "side": { "yaw_deg": 90.0, "pitch_deg": -10.0, "distance": 11.0 },
      "follow": { "yaw_deg": 20.0, "pitch_deg": -12.0, "distance": 6.0 }
    }
  },
  "controls": [
    {
      "id": "strands",
      "type": "choice",
      "default": "one",
      "options": [
        { "id": "one", "n": 1 },
        { "id": "two", "n": 2 },
        { "id": "four", "n": 4 }
      ]
    },
    {
      "id": "mass",
      "type": "slider",
      "unit": " kg",
      "min": 1.0,
      "max": 20.0,
      "step": 1.0,
      "default": 20.0,
      "digits": 0
    }
  ],
  "actions": [
    { "id": "reset", "style": "primary" }
  ],
  "key_observations": ["strands", "pulled", "lift"],
  "predict": {
    "question_face": "thinking",
    "choices": [
      { "id": "hard", "picture": "pulley_one_hard" },
      { "id": "easy", "picture": "pulley_one_easy" }
    ],
    "answer": "hard",
    "bridge_face": "happy"
  },
  "missions": {
    "observe": "required",
    "compare": "less",
    "judge_on": ["top"],
    "miss_on": ["top", "ground"],
    "reveal_on": ["held", "top"],
    "hidden_until_end": ["required", "applied"],
    "hidden_series_until_end": ["required"],
    "stages": [
      {
        "threshold": 200.0,
        "conditions": { "strands": "one", "mass": 20.0 },
        "say_face": "worried",
        "win_face": "happy",
        "miss_face": "worried"
      },
      {
        "threshold": 100.0,
        "conditions": { "strands": "two", "mass": 20.0 },
        "say_face": "explain",
        "win_face": "happy",
        "miss_face": "thinking"
      },
      {
        "threshold": 50.0,
        "conditions": { "strands": "four", "mass": 20.0 },
        "say_face": "happy",
        "win_face": "surprised",
        "miss_face": "thinking"
      }
    ]
  },
  "story": { "clue_face": "explain", "map_clue_face": "explain" },
  "kid": {
    "intro_face": "explain",
    "card": "strands",
    "say_face": "explain",
    "picks": {
      "strands": [
        { "value": "one", "picture": "pulley", "count": 1 },
        { "value": "two", "picture": "pulley", "count": 2 },
        { "value": "four", "picture": "pulley", "count": 4 }
      ]
    }
  },
  "note": {
    "formula": "F = mg / n",
    "numbers": [
      {
        "ids": ["weight"]
      },
      {
        "ids": ["strands"]
      },
      {
        "ids": ["required"]
      },
      {
        "ids": ["pulled", "lift"]
      }
    ],
    "graph": true
  },
  "cast": {
    "dugi": {
      "at": [3.5, 4.0],
      "explain_on": ["held", "top"],
      "delay_s": 0.6
    },
    "puppy": {
      "at": [6.5, -7.5]
    }
  },
  "observations": [
    { "id": "state" },
    { "id": "strands", "digits": 0 },
    { "id": "weight", "unit": "N", "digits": 1 },
    { "id": "required", "unit": "N", "digits": 1 },
    { "id": "applied", "unit": "N", "digits": 1 },
    { "id": "pulled", "unit": "m", "digits": 2 },
    { "id": "lift", "unit": "m", "digits": 2 },
    { "id": "per_metre", "unit": "m", "digits": 0 },
    { "id": "work_in", "unit": "J", "digits": 1 },
    { "id": "work_out", "unit": "J", "digits": 1 }
  ],
  "manipulation": {
    "grab_radius": 72.0,
    "objects": [
      { "id": "rope", "hold": true, "snap": 0.05 }
    ],
    "demo_action": "reset"
  },
  "graph": {
    "x": { "unit": "s", "max": 10.0 },
    "y": { "unit": "N", "min_max": 50.0 },
    "series": [
      { "id": "applied", "color": "#ff3b3b", "style": "line" },
      { "id": "required", "color": "#2d7cf6", "style": "line" }
    ]
  }
}
