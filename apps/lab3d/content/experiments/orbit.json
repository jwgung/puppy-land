{
  "id": "orbit",
  "version": 1,
  "icon": "◎",
  "scene": "res://experiments/orbit/orbit.gd",
  "bench_id": "OR",
  "time_scale": 2.5,
  "camera": {
    "target": [0.0, 1.6, 0.0],
    "distance": 12.5,
    "distance_range": [4.0, 30.0],
    "yaw_range_deg": [-100.0, 100.0],
    "pitch_range_deg": [-89.0, -2.0],
    "pan_radius": 7.0,
    "default_mode": "front",
    "views": {
      "front": { "yaw_deg": 0.0, "pitch_deg": -44.0, "distance": 18.0, "target": [0.0, 1.6, 2.0] },
      "three_quarter": { "yaw_deg": 26.0, "pitch_deg": -42.0 },
      "top": { "yaw_deg": 0.0, "pitch_deg": -89.0, "distance": 17.0 },
      "side": { "yaw_deg": 90.0, "pitch_deg": -14.0, "distance": 16.0 },
      "follow": { "yaw_deg": 20.0, "pitch_deg": -30.0, "distance": 7.0 }
    }
  },
  "controls": [
    {
      "id": "speed",
      "type": "slider",
      "unit": " m/s",
      "min": 0.0,
      "max": 6.0,
      "step": 0.1,
      "default": 3.0,
      "digits": 1
    },
    {
      "id": "direction",
      "type": "slider",
      "unit": "°",
      "min": 0.0,
      "max": 355.0,
      "step": 5.0,
      "default": 90.0,
      "digits": 0
    },
    {
      "id": "radius",
      "type": "slider",
      "unit": " m",
      "min": 2.0,
      "max": 5.0,
      "step": 0.5,
      "default": 3.0,
      "digits": 1
    }
  ],
  "actions": [
    { "id": "launch", "style": "primary" },
    { "id": "circular" },
    { "id": "reset" }
  ],
  "key_observations": ["state", "launch_speed", "escape_speed"],
  "predict": {
    "question_face": "thinking",
    "choices": [
      { "id": "stay", "picture": "orbit_stay" },
      { "id": "leave", "picture": "orbit_leave" }
    ],
    "answer": "stay",
    "bridge_face": "happy"
  },
  "missions": {
    "observe": "laps",
    "judge_on": ["orbiting"],
    "miss_on": ["crash", "leaving", "far"],
    "reveal_on": ["orbiting", "leaving", "crash", "far"],
    "hidden_until_end": ["predicted", "escape_speed", "fetched"],
    "stages": [
      {
        "threshold": 1.0,
        "conditions": { "radius": 4.0 },
        "say_face": "explain",
        "win_face": "happy",
        "miss_face": "thinking"
      },
      {
        "threshold": 2.0,
        "conditions": { "radius": 2.0 },
        "say_face": "explain",
        "win_face": "surprised",
        "miss_face": "thinking"
      },
      {
        "observe": "launch_speed",
        "threshold": 3.67,
        "judge_on": ["far"],
        "also": [{ "observe": "fetched", "compare": "greater", "threshold": 0.5 }],
        "conditions": { "radius": 4.0 },
        "say_face": "surprised",
        "win_face": "surprised",
        "miss_face": "thinking",
        "miss_on": ["crash", "orbiting", "far"]
      }
    ]
  },
  "story": { "clue_face": "surprised", "map_clue_face": "happy" },
  "kid": {
    "intro_face": "explain",
    "card": "state",
    "say_face": "explain",
    "picks": {
      "radius": [
        { "value": 2.0, "picture": "orbit", "size": 0.0 },
        { "value": 3.0, "picture": "orbit", "size": 0.33 },
        { "value": 4.0, "picture": "orbit", "size": 0.67 },
        { "value": 5.0, "picture": "orbit", "size": 1.0 }
      ]
    }
  },
  "note": {
    "numbers": [
      {
        "ids": ["launch_speed"]
      },
      {
        "ids": ["circular_speed"]
      },
      {
        "ids": ["escape_speed"]
      },
      {
        "ids": ["laps"]
      }
    ],
    "graph": true
  },
  "cast": {
    "dugi": {
      "at": [8.0, 4.75],
      "explain_on": ["orbiting", "leaving", "crash", "far"],
      "delay_s": 1.5
    },
    "puppy": {
      "at": [5.1, -8.2]
    }
  },
  "observations": [
    { "id": "state" },
    { "id": "predicted" },
    { "id": "launch_speed", "unit": "m/s", "digits": 2 },
    { "id": "circular_speed", "unit": "m/s", "digits": 2 },
    { "id": "escape_speed", "unit": "m/s", "digits": 2 },
    { "id": "radius", "unit": "m", "digits": 2 },
    { "id": "period", "unit": "s", "digits": 2 },
    { "id": "speed", "unit": "m/s", "digits": 2 },
    { "id": "lap", "unit": "s", "digits": 2 },
    { "id": "laps", "digits": 2 },
    { "id": "fetched", "digits": 0 }
  ],
  "manipulation": {
    "grab_radius": 72.0,
    "objects": [
      { "id": "planet", "surface": "radius_line", "snap": 0.5, "height": false }
    ],
    "demo_action": "launch",
    "slingshot": { "object": "planet" }
  },
  "graph": {
    "x": { "unit": "s", "max": 20.0 },
    "y": { "unit": "m/s", "min_max": 5.0 },
    "series": [
      { "id": "speed", "color": "#2d7cf6", "style": "line" },
      { "id": "circular", "color": "#1fae4b", "style": "line" },
      { "id": "escape", "color": "#ff3b3b", "style": "line" }
    ]
  }
}
