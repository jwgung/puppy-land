; Engine configuration file.
config_version=5

[application]

config/name="Puppy Land 3D"
config/name_localized={
"en": "Bread Cat Science Island",
"ko": "빵고양이 과학섬"
}
config/description="Puppy Land 3D lab app (Phase 1): guided mechanics experiments on Godot 4 + Jolt"
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.38431373, 0.7529412, 1, 1)
boot_splash/image="res://assets/icon/boot_splash.png"
boot_splash/stretch_mode=0
run/main_scene="res://scenes/main.tscn"
run/delta_smoothing=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/project_settings_override="user://renderer_override.cfg"

[autoload]

Quality="*res://scripts/core/quality.gd"
Bench="*res://scripts/core/bench.gd"
Sound="*res://scripts/core/sound_board.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-Lab3dSubset-Regular.otf"

[shader_globals]

story_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
