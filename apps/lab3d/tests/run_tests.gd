## Headless tests for the 3D app.
## Run: apps/lab3d/tools/build.sh test
##   (= godot --headless --path apps/lab3d --fixed-fps 60 -s res://tests/run_tests.gd)
## 1. parity: GDScript PhysicsLaws vs TS-core vectors (tests/incline_vectors.json, generated by
##    tools/incline-vectors.test.ts) for the spec S3 pair and the four surface materials.
## 2. incline formula match: the app's experiment (Jolt + formula correction) reproduces the
##    benchmark spec section 4 table and holds/slides at each material's critical angle.
## 3. shell: content registry, font coverage, camera modes/limits, gesture classification,
##    landscape layout (phone and tablet: full 3D view, key cards, sidebar), front default camera.
## 4. manipulation (Task 2b, tests/manipulation_checks.gd): projection, snap, assist, drag/cancel/
##    height handle/overlap through the real input path, displayed numbers after a new start.
## 5. formula correction layer (Task 3, tests/formula_checks.gd): PhysicsLaws parity for the 10
##    guided mechanics experiments and one representative Jolt scene per correction method.
## 6. uniform-field labs (Task 4a, tests/uniform_lab_checks.gd): free fall and projectile displays and
##    motion against the TS-core vectors (tests/uniform_labs_vectors.json), art, manipulation.
## 6b. ball spin and rolling (Task 4f, tests/ball_spin_checks.gd): no turn in the air (a given spin
##    stays), slide -> roll at 5/7 v0 after t* = 2 v0 / (7 mu g) from the engine ball, the Coulomb
##    friction impulse of a bounce, the mesh turns with the body, free-fall balls never turn, the
##    collision lab's meshes roll with v = omega r.
## 7. push friction lab (Task 4b, tests/friction_lab_checks.gd): displays and motion against the TS-core
##    vectors (tests/friction_lab_vectors.json), threshold, heat, track end, art, the handle input path.
## 8. collision lab (Task 4c, tests/collision_lab_checks.gd): the model and the engine balls step by
##    step against the TS-core vectors (tests/collision_lab_vectors.json), panel, restitution per
##    material, elastic exchange, art, the first collision of a fresh screen, the input path, the demo.
## 9. spring lab (Task 4d, tests/spring_lab_checks.gd): the model and the engine ball step by step
##    against the TS-core vectors (tests/spring_lab_vectors.json), period and energy measured from the
##    engine ball, panel, art, the first release of a fresh screen, the input path, the demo.
## 10. buoyancy lab (Task 4d, tests/buoyancy_lab_checks.gd): the model and the engine drum step by step
##    against the TS-core vectors (tests/buoyancy_lab_vectors.json), floating depth / sinking /
##    neutral from the engine drum, panel, art, a fresh screen, the input path, the demo.
## 11. orbit lab (Task 4d, tests/orbit_lab_checks.gd): the model and the engine planet step by step
##    against the TS-core vectors (tests/orbit_lab_vectors.json), Kepler periods, escape and crash
##    from the engine planet, panel, art, a fresh screen, the input path, the demo.
## 12. constraints lab (Task 4e, tests/constraints_lab_checks.gd): the string and rod pendulum models
##    and engine bobs step by step against the TS-core vectors (tests/constraints_lab_vectors.json),
##    the fixed length, small- and large-angle periods and energy from the engine bobs, panel, art,
##    a fresh screen, the input path, the demo.
## 13. lever lab (Task 4e, tests/rotation_lab_checks.gd): the lever model and the engine beam and load
##    step by step against the TS-core vectors (tests/rotation_lab_vectors.json), the torque balance
##    at the lift from the engine beam, panel, art, the handle / load / fulcrum input path, the demo.
## 14. pulley lab (Task 4e, tests/pulley_lab_checks.gd): the pulley model and the engine load step by
##    step against the TS-core vectors (tests/pulley_lab_vectors.json), lift = rope / n, the rope
##    length and F d = m g h from the engine bodies, panel, art, hand-over-hand input, the demo.
## 7c. camera close-up (tests/camera_focus_checks.gd): the rig's close-up state machine, the throw and
##    the push framed closer and back, 처음으로 at once, the physics timeline unchanged.
## 15. key cards (Task 2d): every listed experiment opens in the front view with 2-3 key cards that
##    show the panel's text.
## 16. island cast (Task 4h, tests/island_cast_checks.gd): the Dugi / Puppy models' mesh contract,
##    the explain cycle (rest -> point -> rest, the stick hidden at rest), the status trigger, placement
##    and layout in every experiment, physics and panels unchanged with the cast.
## 17. game G1 (tests/mission_checks.gd): the missions / predict blocks of the content, the
##    MissionRound (a landed run judged by the formula value, a short throw changes nothing),
##    the ProgressStore (user://progress.cfg, a corrupt file starts over) and the physics
##    invariant: the trajectory and the displayed values are the same with or without the mission.
## 17a. the mission round as a module (tests/mission_round_checks.gd): MissionRound driven through its
##    own interface with a stand-in lab and a memory store (clue, question, answer, bridge, the win line
##    before the stamp, the reason after the first result line, misses, a finished place, no Dugi,
##    automatic conditions), never changing the lab.
## 18. game, the other 10 labs (tests/lab_mission_checks.gd): per lab a scripted round through the
##    screen (a missed stage earns nothing, each stage reachable in the control ranges, one stamp per
##    attempt, the hidden answers), the same steps with and without the round, every picture.
## 19. the labs' ground (tests/lab_world_checks.gd, 2026-10-27: like a corner of the big island): every lab
##    stands on its corner of the map's island (LabWorld): land, beach or sea under every view ray
##    below the horizon (no island rim), flat at y = 0 where the floors and the cast are, its zone's
##    ground and another zone's landmark in view, the projectile's bound at the shore, the map's
##    coast, one opaque mesh.
## 20. easy controls (tests/easy_controls_checks.gd, 2026-10-27): per lab the stage's condition picture
##    buttons (exactly its conditions, a tap = the sidebar's change, clear of the other overlays on
##    phone and tablet), one drag gesture per lab and its grab radius, the removed handles gone.
## 20a. object controls (tests/object_controls_checks.gd, 2026-10-28): no handle in the collision,
##    orbit, friction, lever and pulley labs; the slingshot of ball A and the planet, the press and hold
##    of the box, the effort end and the rope end (rates per stage, the heaviest within ~3 s); the same
##    runs as the forces / values given without the hand; empty space does nothing; one tap is one.
## 18b. the piece game (tests/game_piece_checks.gd, 2026-10-29): six labs' game objects judged on the
##     formula (crate hit, B's speed, landing together, speed at the slide's end, the swing on the beat),
##     each stage reachable with its fitting picks and not with a non-fitting one; the piece in its
##     object until the last stamp, then on the ground, handed to the bread cat.
## 20b. kid words and the science note (tests/kid_words_checks.gd, 2026-10-28): a stage judges the
##    number its card shows, the free fall's card is the red ball's time, the spring's first stage shows
##    the pull, the push's card is a bar, no 뉴턴 / 초속 / decimals in the kid texts, and every lab's
##    자세히 is a science note (법칙 + formula, 3-4 numbers, conditions, graph where kept, 더 보기 closed).
## 20c. ask an AI (tests/ask_ai_checks.gd, 2026-10-28, the system chooser of the AI apps only since
##    2026-10-29): every lab's 자세히 ends with "AI에게 더 물어보기"; the question holds the title, law,
##    formula, the conditions and numbers of this run in their units and Dugi's words, nothing
##    personal; one tap is one hand-off of the AI packages (content/ai_apps.json) and the question;
##    a copy (desktop) shows its line; no button in a measurement.
## 21. condition looks (tests/condition_look_checks.gd, 2026-10-28): the bodies look as heavy as they
##    are (MassLook: cube root, equal masses equal, standing where the body is, the collision balls
##    touching at the model's contact), the gravity's signpost and the surface materials follow their
##    controls, the picture buttons draw a mass like the lab; physics unchanged with or without them.
## 23. story (tests/story_checks.gd, 2026-10-28 "별 조각 찾기"): the prologue once (camera moves, night
##    and day, skip, replay, the child's camera and a clean map afterwards), Puppy's clue once per spot
##    before the question, the piece only on a completed round, its flight once and the emblem's count,
##    old saves, the finale once at 11 (the sky star), no story in measurements.
## 23a. title and faces (tests/title_checks.gd, tests/faces_checks.gd, 2026-10-29): the title on every
##    child's launch (skipped by measurements, --experiment, --screen, resume), its buttons' ways
##    (prologue first time, map later, replay, settings and back), its layout; the dialogue's faces
##    per line (files, tags, no re-pop, stable box), Dugi's explanation per stage, Puppy's words.
## 23b. the night map (tests/explore_checks.gd, 2026-10-28 "explore the night map in a fixed order"): the
##    order and the next spot, only the next and found spots open (a locked tap: Puppy's line, a shake),
##    names hidden until found, Puppy's riddle on open / after a flight / on a tap on him or 단서, the
##    hint's glint after the delay, the night by pieces (day after the finale), old saves, a direct
##    --experiment launch and the bench map unaffected.
## 22. sound (tests/sound_checks.gd, 2026-10-28): every event asks SoundBoard for its sound id, the
##    효과음 / 배경 음악 switches mute their bus and are kept in the settings file (the real one untouched),
##    the music loops, a measurement plays nothing and writes nothing, nothing sounds while idle.
## 20d. hands on (tests/hands_on_checks.gd, 2026-10-29 round 3): only 다시 on a game lab, every run from the
##    hand (free fall, slide, drum, spring, bob let go), the demo and --auto-release; Puppy's 66 result
##    lines and their bubble; Dugi's bridge, the strip's pulse, the reason after the first line, every
##    question answered by stage 1; the orbit shown 2.5x faster with the model's numbers; the play yard
##    spread out; the pulley rope on the wheels' rims.
## 23c. UI polish (tests/polish_checks.gd, 2026-10-29): 자세히's header (닫기) stays above the scrolled
##    note; a vertical drag from a button, check box or slider scrolls the settings and the note
##    (DragScroll) and presses nothing; check boxes instead of switches; 처음부터 다시 하기 asks first and
##    then erases the whole store; the map walk (speed, Puppy and Dugi following apart, map-size
##    actors, the last spot kept) and the story with the new places.
## Times are engine fixed steps (60 Hz), independent of rendering FPS.
extends SceneTree

const VECTORS_PATH := "res://tests/incline_vectors.json"
## Scripts that use the Quality/Bench autoloads are loaded at runtime: with `-s` the autoload names
## do not exist yet when this file is compiled.
const VIEW_3D := "res://scripts/shell/view_3d.gd"
const EXPERIMENT_SCREEN := "res://scripts/shell/experiment_screen.gd"
const UI_THEME := "res://scripts/app/ui_theme.gd"
const STEP_HZ := 60
## Landscape screens in UI units (the short side is 720): phone 2340x1080, tablet 1920x1200 (SM-P200).
const PHONE_LANDSCAPE := Vector2(1560, 720)
const TABLET_LANDSCAPE := Vector2(1152, 720)

var _failures := 0
## A key card over the 3D view never shows a unit symbol or a formula letter (N, m/s², J, √, θ, v₀...).
var _kid_symbols := RegEx.create_from_string("[A-Za-z√θ₀²³·μ=°]")
var _lab: Experiment
var _vectors: Dictionary


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	# Every screen with missions saves stamps: the run uses its own progress file, never the
	# child's (user://progress.cfg is checked unchanged at the end).
	var real_progress := _file_state(ProgressStore.PATH)
	ProgressStore.path = ProgressStore.TEST_PATH
	DirAccess.remove_absolute(ProgressStore.path)
	# The story plays only where a check turns it on (tests/story_checks.gd): the App screens the
	# other checks build never start it.
	Story.app_may_enable = false
	Story.enabled = false
	# Likewise the title: only the title checks build it (loaded by path: TitleScreen needs the autoloads).
	(load("res://scripts/app/title_screen.gd") as GDScript).set("app_may_show", false)
	_vectors = JSON.parse_string(FileAccess.get_file_as_string(VECTORS_PATH))
	print("== parity: GDScript PhysicsLaws vs TS core vectors ==")
	_check_parity()
	print("== content and fonts ==")
	var definition := _check_content()
	_check_fonts()
	print("== incline formula match (Jolt + correction layer, %d Hz fixed step) ==" % STEP_HZ)
	_lab = ExperimentRegistry.instantiate(definition)
	root.add_child(_lab)
	await process_frame
	await _check_spec_table()
	await _check_materials(definition)
	await _check_bounded_and_floor()
	await _check_left_status()
	await _check_art_is_visual_only()
	await _check_juice_rotated_landing()
	_check_stand_clearance()
	_check_ramp_shadow_scale()
	_lab.queue_free()
	print("== shell: camera, gestures, layout ==")
	await _check_camera(definition)
	await _check_gestures(definition)
	await _check_gesture_input_state(definition)
	await _check_layout(definition)
	await _check_button_feedback()
	await _check_slide_in()
	await _check_banner_collapsed()
	await _check_list_cards()
	_check_art_atlases()
	await _check_launch_args_flag(definition)
	await _check_graph_redraw(definition)
	_check_wheel_zoom(definition)
	_check_settings_marker(definition)
	_check_bench_report()
	print("== manipulation: projection, snap, cancel, height handle, new start positions ==")
	var checks: GDScript = load("res://tests/manipulation_checks.gd")
	_expect(checks != null and checks.can_instantiate(), "manipulation checks compile", "")
	if checks != null and checks.can_instantiate():
		await checks.new(self, _expect, _vectors).run(definition)
	print("== formula correction layer: parity for the 10 guided experiments, representative scenes ==")
	var formula: GDScript = load("res://tests/formula_checks.gd")
	_expect(formula != null and formula.can_instantiate(), "formula checks compile", "")
	if formula != null and formula.can_instantiate():
		await formula.new(self, _expect).run()
	print("== uniform-field labs (Task 4a): free fall, projectile ==")
