func _check_content() -> Dictionary:
	var all := ExperimentRegistry.load_all()
	_expect(all.size() >= 1, "registry loads experiments", "%d" % all.size())
	var definition := ExperimentRegistry.find("incline-friction")
	_expect(not definition.is_empty() and ExperimentRegistry.validate(definition).is_empty(), "incline-friction definition valid",
		", ".join(ExperimentRegistry.validate(definition)) if not definition.is_empty() else "missing")
	var broken := definition.duplicate(true)
	broken.camera.default_mode = "sideways"
	broken.controls[0].erase("default")
	_expect(ExperimentRegistry.validate(broken).size() >= 2, "registry rejects an invalid definition", ", ".join(ExperimentRegistry.validate(broken)))
	var duplicate := definition.duplicate(true)
	duplicate.controls.append(duplicate.controls[0].duplicate(true))
	_expect(ExperimentRegistry.validate(duplicate).size() == 1 and "duplicate" in ExperimentRegistry.validate(duplicate)[0], "registry rejects a duplicate control id", ", ".join(ExperimentRegistry.validate(duplicate)))
	_expect(ExperimentRegistry.CAMERA_MODES == CameraRig.MODES, "registry camera modes are the rig's modes", "")
	var views_missing := definition.duplicate(true)
	views_missing.camera.views.erase("follow")
	_expect(ExperimentRegistry.validate(views_missing).size() == 1 and "follow" in ExperimentRegistry.validate(views_missing)[0],
		"registry requires a view for every preset camera mode", ", ".join(ExperimentRegistry.validate(views_missing)))
	# Task 2d: key_observations are 2-3 distinct observation ids; a view target is [x, y, z].
	# (Each list keeps the slide's one kid card, bottom_speed since 2026-10-29, so only the list is wrong.)
	var key_cases := {"one": ["bottom_speed"], "four": ["bottom_speed", "critical_angle", "distance", "run"], "unknown": ["bottom_speed", "speed"],
		"duplicate": ["bottom_speed", "bottom_speed"], "missing": null}
	var key_problems := PackedStringArray()
	for case in key_cases:
		var keyed := definition.duplicate(true)
		if key_cases[case] == null:
			keyed.erase("key_observations")
		else:
			keyed.key_observations = key_cases[case]
		var found := ExperimentRegistry.validate(keyed)
		if found.size() != 1 or not "key_observations" in found[0]:
			key_problems.append("%s: %s" % [case, ", ".join(found)])
	var bad_target := definition.duplicate(true)
	bad_target.camera.views.front.target = [0.0, 1.0]
	var target_found := ExperimentRegistry.validate(bad_target)
	_expect(key_problems.is_empty() and target_found.size() == 1 and "front.target" in target_found[0],
		"registry rejects key_observations that are not 2-3 distinct observation ids, and a malformed view target",
		", ".join(key_problems) + " | " + ", ".join(target_found))
	var not_experiment := definition.duplicate(true)
	not_experiment.scene = "res://scripts/shell/graph_view.gd"   # exists, but does not extend Experiment
	_expect(not ExperimentRegistry.validate(not_experiment).is_empty(), "registry rejects a scene script that is not an Experiment",
		", ".join(ExperimentRegistry.validate(not_experiment)))
	# Content materials must equal the TS-derived coefficient sets (vitest checks JSON vs TS too).
	var ok := true
	for control in definition.controls:
		if control.id != "material":
			continue
		for option in control.options:
			for set in _vectors.sets:
				if set.id == option.id:
					ok = ok and absf(float(set.mu_s) - float(option.mu_s)) < 1e-9 and absf(float(set.mu_k) - float(option.mu_k)) < 1e-9
	_expect(ok, "content materials = TS MATERIALS", "")
	_check_own_texts(definition)
	return definition


## Each listed experiment writes its own texts (since 2026-10-30, ADR 0002; before, they came from the
## web-shared content/mechanics-labs.json): no `content` key is left, no shared file, and the incline's
## panel texts are as they were.
func _check_own_texts(incline: Dictionary) -> void:
	var own := true
	for definition in ExperimentRegistry.load_all():
		own = own and not definition.has("content") and str(definition.get("title", "")) != "" \
			and (definition.steps as Array).size() == 3 and str(definition.get("observe", "")) != "" \
			and str(definition.get("tip", "")) != "" and (definition.get("law", {}) as Dictionary).has("equation")
	_expect(own and not FileAccess.file_exists("res://content/mechanics-labs.json"),
		"every listed experiment writes its texts itself (title, three steps, observe, tip, law); no shared file", "")
	var stray := incline.duplicate(true)
	stray["content"] = "incline-friction"
	var refused := ExperimentRegistry.validate(stray)
	_expect(refused.size() == 1 and "content" in refused[0], "registry rejects a leftover `content` key (the old shared texts)", ", ".join(refused))
	_expect(incline.title == "빗면을 얼마나 기울이면 미끄러질까?" and incline.steps.size() == 3 and incline.terms.size() == 4
		and incline.law.equation == "mg sinθ > μs·mg cosθ · a = g(sinθ − μk cosθ)" and incline.tip.begins_with("상자를 한 손가락으로 끌어"),
		"incline texts unchanged", incline.title)


func _check_fonts() -> void:
	var theme_script: Script = load(UI_THEME)
	var regular: Font = theme_script.regular_font()
	var bold: Font = theme_script.bold_font()
	var covers := func(font: Font, code: int) -> bool:
		return font.has_char(code) or font.fallbacks.any(func(f: Font) -> bool: return f.has_char(code))
	var missing := ""
	for path in _text_files("res://scripts") + _text_files("res://experiments") + _text_files("res://content"):
		for c in FileAccess.get_file_as_string(path):
			var code := c.unicode_at(0)
			if code > 126 and code != 0xFEFF and (not covers.call(regular, code) or not covers.call(bold, code)) and c not in missing:
				missing += c
	_expect(missing == "", "UI fonts cover every used character", "missing: %s (run tools/subset_font.sh)" % missing if missing != "" else "")


func _text_files(dir: String) -> PackedStringArray:
	var result := PackedStringArray()
	for file in DirAccess.get_files_at(dir):
		if file.ends_with(".gd") or file.ends_with(".json"):
			result.append(dir.path_join(file))
	for sub in DirAccess.get_directories_at(dir):
		result.append_array(_text_files(dir.path_join(sub)))
	return result


func _check_camera(definition: Dictionary) -> void:
	var holder := Node3D.new()
	root.add_child(holder)
	var rig := CameraRig.new()
	holder.add_child(rig)
	var target := Node3D.new()
	target.set_script(load("res://tests/follow_probe.gd"))
	holder.add_child(target)
	rig.follow_source = target
	rig.configure(definition.camera)
	_expect(rig.mode == definition.camera.default_mode, "camera starts in the experiment's default mode", rig.mode)
	var views: Dictionary = definition.camera.views
	var ok := true
	for mode in ["front", "three_quarter", "top", "side"]:
		rig.set_mode(mode)
		_step(rig, 1.0)
		var view: Dictionary = views[mode]
		ok = ok and rig.is_settled() and absf(rad_to_deg(rig.cur_yaw) - float(view.yaw_deg)) < 0.1 \
			and absf(rad_to_deg(rig.cur_pitch) - float(view.pitch_deg)) < 0.1
	_expect(ok, "preset modes ease to their views within 1 s", "front, 3/4, top, side")
	rig.set_mode("front")
	_step(rig, 0.1)
	_expect(not rig.is_settled() and rig.cur_yaw > 0.0, "mode change is a smooth transition (not a jump)", "yaw after 0.1 s %.1f deg" % rad_to_deg(rig.cur_yaw))
	rig.orbit(Vector2(-100000, 100000))
	var limits_ok := rig.mode == "orbit" and rig.goal_yaw <= deg_to_rad(definition.camera.yaw_range_deg[1]) + 1e-6 \
		and rig.goal_pitch >= deg_to_rad(definition.camera.pitch_range_deg[0]) - 1e-6
	_expect(limits_ok, "turning switches to 제한 회전 and stays inside the limits",
		"yaw %.1f, pitch %.1f deg" % [rad_to_deg(rig.goal_yaw), rad_to_deg(rig.goal_pitch)])
	rig.zoom(0.0001)
	_expect(is_equal_approx(rig.goal_distance, definition.camera.distance_range[0]), "zoom clamps to the distance range", "%.2f" % rig.goal_distance)
	rig.pan_by(Vector2(100000, 0))
	_expect(rig.pan.length() <= definition.camera.pan_radius + 1e-4, "pan stays inside pan_radius", "%.2f" % rig.pan.length())
	rig.set_mode("front")
	var front_distance: float = definition.camera.views.front.get("distance", definition.camera.distance)
	_expect(rig.pan == Vector3.ZERO and is_equal_approx(rig.goal_distance, front_distance), "front mode resets pan and zoom", "%.2f" % rig.goal_distance)
	# A view with its own target looks there; the others keep camera.target (Task 2d).
	var aimed: Dictionary = definition.camera.duplicate(true)
	aimed.views.front.target = [0.5, 4.0, 0.0]
	rig.configure(aimed)
	var front_at := rig._goal_target()
	rig.set_mode("side", true)
	var side_at := rig._goal_target()
	rig.set_mode("front", true)
	var round_trip := rig.get_state()
	rig.set_mode("side", true)
	rig.set_state(round_trip)
	_expect(front_at.is_equal_approx(Vector3(0.5, 4.0, 0.0)) and side_at.is_equal_approx(rig.base_target) and rig._goal_target().is_equal_approx(front_at),
		"a view's own target is used for that view only and survives a state round-trip", "front %s, side %s" % [front_at, side_at])
	rig.configure(definition.camera)
	rig.set_mode("follow")
	target.position = Vector3(3, 1, 0)
	_step(rig, 1.5)
	_expect(rig.cur_target.distance_to(Vector3(3, 1, 0)) < 0.01, "follow mode tracks the experiment's follow point", str(rig.cur_target))
	# set_mode(instant) snaps to the NEW mode's target (follow reads the mode in snap()).
	target.position = Vector3(7, 1, 0)
	rig.set_mode("front")
	rig.set_mode("follow", true)
	_expect(rig.cur_target.distance_to(Vector3(7, 1, 0)) < 0.01, "instant mode change snaps to the new mode's target", str(rig.cur_target))
	# A gesture during a transition keeps the remaining transition (no jump to the goal).
	rig.set_mode("front", true)
	rig.set_mode("top")
	rig.goal_distance = clampf(rig.cur_distance + 2.0, rig.distance_range.x, rig.distance_range.y)  # a pending distance change too
	_step(rig, 0.1)
	var lag_yaw := rig.goal_yaw - rig.cur_yaw
	var lag_pitch := rig.goal_pitch - rig.cur_pitch
	var lag_distance := rig.goal_distance - rig.cur_distance
	rig.orbit(Vector2(10, 10))
	rig.zoom(0.9)
	_expect(is_equal_approx(rig.goal_yaw - rig.cur_yaw, lag_yaw) and is_equal_approx(rig.goal_pitch - rig.cur_pitch, lag_pitch),
		"orbit during a transition does not jump", "yaw lag %.3f, pitch lag %.3f" % [rig.goal_yaw - rig.cur_yaw, rig.goal_pitch - rig.cur_pitch])
	_expect(absf(lag_distance) > 0.1 and is_equal_approx(rig.goal_distance - rig.cur_distance, lag_distance), "zoom during a transition does not jump", "%.3f" % (rig.goal_distance - rig.cur_distance))
	rig.set_mode("front", true)
	rig.cur_target += Vector3(1, 0, 0)  # a target transition still under way
	var lag_target := rig._goal_target() - rig.cur_target
	rig.pan_by(Vector2(5, 5))
	_expect(lag_target.length() > 0.0 and (rig._goal_target() - rig.cur_target).is_equal_approx(lag_target),
		"pan during a transition does not jump", str(rig._goal_target() - rig.cur_target))
	var saved := rig.get_state()
	rig.set_mode("side", true)
	rig.set_state(saved)
	_expect(rig.mode == saved.mode and is_equal_approx(rig.goal_yaw, saved.yaw) and is_equal_approx(rig.cur_distance, saved.distance),
		"camera state round-trips", rig.mode)
	# Landing dip: moves only the drawn view, then settles back.
	rig.set_mode("three_quarter", true)
	var before := rig.get_state()
	var eye := rig.global_position
	rig.nudge(1.0)
	_step(rig, 0.05)
	var dipped := rig.global_position.y - eye.y
	var same_goal := rig.get_state() == before
	_step(rig, 1.0)
	_expect(dipped < -0.01 and dipped > -0.1 and same_goal and rig.shake == 0.0 and rig.global_position.is_equal_approx(eye),
		"landing nudge dips the view a few cm and settles without changing the mode or goal", "dip %.3f m" % dipped)
	holder.queue_free()


func _step(rig: CameraRig, seconds: float) -> void:
	for i in int(seconds * 60.0):
		rig._process(1.0 / 60.0)


func _check_gestures(definition: Dictionary) -> void:
	var view: Control = load(VIEW_3D).new()
	view.size = Vector2(720, 600)
	root.add_child(view)
	view.rig.configure(definition.camera)
	var pointer_events: Array[String] = []
	view.single_pointer.connect(func(kind: String, _p: Vector2) -> void: pointer_events.append(kind))
	# One finger dragging on the empty view: no camera change, reported for manipulation (2b).
	var yaw: float = view.rig.goal_yaw
	var distance: float = view.rig.goal_distance
	_touch(view, 0, Vector2(300, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 + i * 20, 300))
	_touch(view, 0, Vector2(500, 300), false)
	_expect(view.rig.goal_yaw == yaw and view.rig.goal_distance == distance and pointer_events.has("move"),
		"one finger does not turn the camera", "events %s" % ",".join(pointer_events))
	# With one_finger_pan (the labs): a finger starting on an empty spot moves the view; one that
	# lands where claims_press says something is picked leaves the camera alone.
	view.one_finger_pan = true
	view.claims_press = func(p: Vector2) -> bool: return p.x < 100.0
	var one_pan_before: Vector3 = view.rig.pan
	_touch(view, 0, Vector2(300, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 + i * 20, 300))
	_touch(view, 0, Vector2(500, 300), false)
	var panned: Vector3 = view.rig.pan
	_expect(panned != one_pan_before and view.rig.goal_yaw == yaw, "one finger on an empty spot moves the view (no turn)", "pan %s -> %s" % [str(one_pan_before), str(panned)])
	_touch(view, 0, Vector2(50, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(50 + i * 20, 300))
	_touch(view, 0, Vector2(250, 300), false)
	_expect(view.rig.pan == panned, "one finger that picks something does not move the view", "pan %s" % str(view.rig.pan))
	view.one_finger_pan = false
	view.claims_press = Callable()
	# Two fingers moving together: orbit.
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(400, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 + i * 10, 300))
		_drag(view, 1, Vector2(400 + i * 10, 300))
	_expect(view.rig.goal_yaw != yaw and view.rig.mode == "orbit" and is_equal_approx(view.rig.goal_distance, distance),
		"two-finger drag turns the view (제한 회전)", "yaw %.1f -> %.1f deg" % [rad_to_deg(yaw), rad_to_deg(view.rig.goal_yaw)])
	# Lifting one finger ends the gesture; the remaining finger does not become a drag.
	pointer_events.clear()
	_touch(view, 1, Vector2(490, 300), false)
	var yaw_after: float = view.rig.goal_yaw
	for i in 5:
		_drag(view, 0, Vector2(390 + i * 20, 300))
	_touch(view, 0, Vector2(470, 300), false)
	_expect(view.rig.goal_yaw == yaw_after and not pointer_events.has("move") and not pointer_events.has("release"),
		"the finger left after a two-finger gesture is ignored", "events %s" % ",".join(pointer_events))
	# Two fingers spreading: zoom in (and pan with the midpoint).
	distance = view.rig.goal_distance
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(400, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 - i * 10, 300))
		_drag(view, 1, Vector2(400 + i * 10, 300))
	_expect(view.rig.goal_distance < distance * 0.7, "pinch-out zooms in", "distance %.2f -> %.2f" % [distance, view.rig.goal_distance])
	_touch(view, 1, Vector2(490, 300), false)
	_touch(view, 0, Vector2(210, 300), false)
	# Two fingers close together, moving together after a small pinch: pan.
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(340, 300), true)
	_drag(view, 1, Vector2(360, 300))  # spread first -> pinch gesture
	var pan_before: Vector3 = view.rig.pan
	for i in 10:
		_drag(view, 0, Vector2(300, 300 + i * 10))
		_drag(view, 1, Vector2(360, 300 + i * 10))
	_expect(view.rig.pan.distance_to(pan_before) > 0.05, "pinch gesture moves (pans) the view", "pan %s" % str(view.rig.pan))
	_touch(view, 1, Vector2(480, 300), false)
	_touch(view, 0, Vector2(200, 300), false)
	# Three fingers: lifting the lowest-index one changes the active pair; the reference follows.
	_touch(view, 0, Vector2(100, 100), true)
	_touch(view, 1, Vector2(200, 100), true)
	_touch(view, 2, Vector2(400, 500), true)
	_touch(view, 0, Vector2(100, 100), false)
	var mid: Vector2 = (Vector2(200, 100) + Vector2(400, 500)) * 0.5
	_expect(view._gesture_start_mid.is_equal_approx(mid) and is_equal_approx(view._gesture_start_span, Vector2(200, 100).distance_to(Vector2(400, 500))),
		"the gesture reference is re-taken when the active finger pair changes", str(view._gesture_start_mid))
	_touch(view, 1, Vector2(200, 100), false)
	_touch(view, 2, Vector2(400, 500), false)
	view.queue_free()


## One finger held still while the other moves (Android sends no drag for the still one), a
## twist below the threshold, cancelled touches, and input state lost with the tree.
func _check_gesture_input_state(definition: Dictionary) -> void:
	var view: Control = load(VIEW_3D).new()
	view.size = Vector2(720, 600)
	root.add_child(view)
	view.rig.configure(definition.camera)
	var events: Array[String] = []
	view.single_pointer.connect(func(kind: String, _p: Vector2) -> void: events.append(kind))
	var mode_before: String = view.rig.mode
	var distance: float = view.rig.goal_distance
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(400, 300), true)
	for i in 10:
		_drag(view, 0, Vector2(300 - i * 10, 300))   # only finger 0 moves
	_expect(view.rig.goal_distance < distance * 0.8 and view.rig.mode == mode_before,
		"a pinch with one finger held still zooms", "distance %.2f -> %.2f, mode %s" % [distance, view.rig.goal_distance, view.rig.mode])
	_touch(view, 1, Vector2(400, 300), false)
	_touch(view, 0, Vector2(210, 300), false)
	# Small twist during a pinch keeps the preset view; a clear twist turns it.
	var mid := Vector2(350, 300)
	_touch(view, 0, mid - Vector2(50, 0), true)
	_touch(view, 1, mid + Vector2(50, 0), true)
	_drag(view, 0, mid - Vector2(65, 0))
	_drag(view, 1, mid + Vector2(65, 0))
	_expect(view._gesture == "pinch", "spreading classifies as pinch", view._gesture)
	for degrees in [1.0, 3.0, 5.0, 6.5]:
		var offset := Vector2.from_angle(deg_to_rad(degrees)) * 65.0
		_drag(view, 0, mid - offset)
		_drag(view, 1, mid + offset)
	_expect(view.rig.mode == mode_before and mode_before != "orbit", "a pinch with a small twist keeps the preset view", view.rig.mode)
	var yaw: float = view.rig.goal_yaw
	for degrees in [10.0, 15.0, 20.0, 30.0]:
		var offset := Vector2.from_angle(deg_to_rad(degrees)) * 65.0
		_drag(view, 0, mid - offset)
		_drag(view, 1, mid + offset)
	_expect(view.rig.mode == "orbit" and absf(rad_to_deg(view.rig.goal_yaw - yaw)) > 10.0 and absf(rad_to_deg(view.rig.goal_yaw - yaw)) < 30.0,
		"a twist beyond the threshold turns the view by the excess", "yaw change %.1f deg" % rad_to_deg(view.rig.goal_yaw - yaw))
	_touch(view, 1, mid, false)
	_touch(view, 0, mid, false)
	# Cancelled touch is reported as cancel, not release.
	events.clear()
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 0, Vector2(300, 300), false, true)
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 0, Vector2(300, 300), false)
	_expect(",".join(events) == "press,cancel,press,release", "a cancelled touch is reported as cancel", ",".join(events))
	# Leaving the tree (settings) drops finger and mouse state.
	events.clear()
	_touch(view, 0, Vector2(300, 300), true)
	_touch(view, 1, Vector2(400, 300), true)
	view._gui_input(_mouse_button(MOUSE_BUTTON_RIGHT, true))
	root.remove_child(view)
	_expect(view._touches.is_empty() and view._gesture == "" and view._mouse_mode == "", "leaving the tree resets touches, gesture and mouse mode",
		"%d touches, gesture '%s', mouse '%s'" % [view._touches.size(), view._gesture, view._mouse_mode])
	root.add_child(view)
	events.clear()
	_touch(view, 0, Vector2(300, 300), true)
	root.remove_child(view)
	_expect(",".join(events) == "press,cancel", "a single finger on the view is cancelled when it leaves the tree", ",".join(events))
	root.add_child(view)
	# Mouse: the right button released elsewhere must not leave the view orbiting.
	view._gui_input(_mouse_button(MOUSE_BUTTON_RIGHT, true))
	yaw = view.rig.goal_yaw
	var motion := InputEventMouseMotion.new()
	motion.relative = Vector2(40, 0)
	motion.button_mask = 0
	view._gui_input(motion)
	_expect(view.rig.goal_yaw == yaw and view._mouse_mode == "", "mouse motion without the held button does not orbit", "")
	view.queue_free()


func _mouse_button(button: int, pressed: bool) -> InputEventMouseButton:
	var event := InputEventMouseButton.new()
	event.button_index = button
	event.pressed = pressed
	return event


func _touch(view: Control, index: int, position: Vector2, pressed: bool, canceled := false) -> void:
	var event := InputEventScreenTouch.new()
	event.index = index
	event.position = position
	event.pressed = pressed
	event.canceled = canceled
	view._gui_input(event)


func _drag(view: Control, index: int, position: Vector2) -> void:
	var event := InputEventScreenDrag.new()
	event.index = index
	event.position = position
	view._gui_input(event)


## Task 2d layout (landscape only), on a phone (2340x1080 -> 1560x720 units) and a tablet
## (1920x1200 -> 1152x720): the 3D view fills the screen with the sidebar closed; over it the key
## cards (same text as the panel tiles) and the action buttons; no "정면으로" and no camera chips
## over the view; the sidebar opens and closes with a slide (only the sidebar moves, the view is
## resized once), and the view never lies under the open sidebar.
func _check_layout(definition: Dictionary) -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	root.add_child(host)
	for size: Vector2 in [PHONE_LANDSCAPE, TABLET_LANDSCAPE]:
		var name := "phone" if size == PHONE_LANDSCAPE else "tablet"
		host.size = size
		var screen: Control = load(EXPERIMENT_SCREEN).new()
		screen.setup(definition)
		host.add_child(screen)
		await process_frame
		await process_frame
		var view_rect := Rect2(Vector2.ZERO, screen.view.size)
		_expect(screen.view.size == size and not screen._sidebar.visible and not screen.is_sidebar_open(),
			"%s landscape: the 3D view fills the screen, sidebar closed" % name, "view %s" % screen.view.size)
		var texts := _button_texts(screen)
		# No camera chips anywhere, the 자세히 sidebar included (its 시점 section went, 2026-10-27 user request).
		var view_chips := _button_texts(screen).filter(func(t: String) -> bool: return t in CameraRig.MODE_LABELS.values())
		_expect("정면으로" not in texts and view_chips.is_empty() and screen.view.rig.mode == "front",
			"%s landscape: front camera, no 정면으로 button, no camera chips (over the view or in the sidebar)" % name, "mode %s, chips %s" % [screen.view.rig.mode, str(view_chips)])
		var overlays: Array[Control] = [screen._title_bar, screen._top_buttons, screen._key_row, screen._action_row]
		var inside := overlays.all(func(c: Control) -> bool: return view_rect.encloses(c.get_rect()) and c.size.x > 0.0)
		var apart := true
		for i in overlays.size():
			for j in range(i + 1, overlays.size()):
				apart = apart and not overlays[i].get_rect().intersects(overlays[j].get_rect())
		# A game lab draws only 다시 (2026-10-29: every run starts from the hand); another lab every action.
		var game_lab := not MissionRound.missions(definition).is_empty()
		var actions_ok: bool = definition.actions.all(func(a: Dictionary) -> bool: return (game_lab and a.id != "reset" and not screen._action_buttons.has(a.id)) \
			or (screen._action_buttons.has(a.id) and (screen._action_buttons[a.id].get_parent() == screen._action_row or screen._extra_actions.has(screen._action_buttons[a.id]))))
		var compact: bool = screen._key_row.size.y <= 160.0 and screen._key_row.size.x <= size.x - 470.0 - 24.0
		var cards := ExperimentRegistry.shown_cards(definition)
		# A game lab (2026-10-27): one card, reset as a small "다시" and (2026-10-29) no other button.
		var lean := true
		if game_lab:
			lean = cards.size() == 1 and screen._action_buttons.reset.text == screen.RESET_SHORT \
				and screen._action_row.get_child_count() == 1 and screen._extra_actions.is_empty()
		_expect(inside and apart and actions_ok and compact and lean and screen._key_row.get_child_count() == cards.size(),
			"%s landscape: title, buttons, %d key card(s) and the actions sit inside the view without overlapping (a game lab: one card, only 다시)" % [name, cards.size()],
			"key row %s, actions %s" % [screen._key_row.get_rect(), screen._action_row.get_rect()])
		var h_closed := _horizontal_fov(screen.view)
		screen.open_sidebar()
		await process_frame
		var side: float = screen.sidebar_width()
		var mid_x: float = screen._sidebar.position.x
		var shrunk_at_once: bool = is_equal_approx(screen.view.size.x, size.x - side)
		for i in 20:
			await process_frame
		var open_ok: bool = screen.is_sidebar_open() and screen._sidebar.visible and is_equal_approx(screen._sidebar.position.x, size.x - side) \
			and is_equal_approx(screen.view.size.x, size.x - side) and screen.view.size.y == size.y and not screen._sidebar_button.visible
		_expect(open_ok and shrunk_at_once and mid_x > size.x - side and mid_x < size.x,
			"%s landscape: the sidebar slides in (%.0f units), the view shrinks once to the area left of it" % [name, side],
			"mid-slide x %.0f, open x %.0f, view %s" % [mid_x, screen._sidebar.position.x, screen.view.size])
		var h_open := _horizontal_fov(screen.view)
		_expect(h_open >= minf(h_closed, 73.3) and h_closed >= 73.3,
			"%s landscape: the view beside the sidebar keeps at least the 16:10 screen's horizontal field of view (the whole apparatus stays in frame)" % name,
			"closed %.1f deg, open %.1f deg" % [h_closed, h_open])
		var back_closes: bool = screen.handle_back() and not screen.is_sidebar_open()
		await process_frame
		var kept_while_closing: bool = is_equal_approx(screen.view.size.x, size.x - side)
		for i in 20:
			await process_frame
		_expect(back_closes and not screen.handle_back() and kept_while_closing and not screen.is_sidebar_open() and not screen._sidebar.visible \
			and screen.view.size == size and screen._sidebar_button.visible,
			"%s landscape: back closes the open sidebar (slides out, then the view fills the screen again); with it closed, back leaves the screen" % name,
			"view %s" % screen.view.size)
		screen.queue_free()
		await process_frame
	host.queue_free()


## Every listed experiment: front camera by default, 2-3 key cards that show the panel's text.
func _check_key_cards() -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = TABLET_LANDSCAPE   # the narrowest view: the tablet's beside the open sidebar
	root.add_child(host)
	for definition in ExperimentRegistry.load_all():
		var screen: Control = load(EXPERIMENT_SCREEN).new()
		screen.setup(definition)
		host.add_child(screen)
		await process_frame
		await process_frame
		screen._poll()
		screen.open_sidebar(false)
		await process_frame
		await process_frame
		var tip: Control = screen._tip
		var tip_clear: bool = not tip.visible or (not tip.get_rect().intersects(screen._action_row.get_rect()) \
			and not tip.get_rect().intersects(screen._key_row.get_rect()) and tip.size.x >= 300.0 \
			and Rect2(Vector2.ZERO, screen.view.size).encloses(tip.get_rect()))
		var sidebar_fits: bool = is_equal_approx(screen._sidebar.size.x, screen.sidebar_width()) \
			and is_equal_approx(screen._sidebar.position.x + screen._sidebar.size.x, TABLET_LANDSCAPE.x)
		# The cards read the panel's values in a child's words (the screen's card_text: one decimal,
		# the unit spelled out, no symbol); the sidebar keeps format_observation's full text.
		var same := true
		var shown := PackedStringArray()
		var values: Dictionary = screen.experiment.observations()
		var hidden: Array = screen._hidden_answers(values)
		for id in screen.key_card_ids():
			var observation: Dictionary = screen._observation(id)
			var card: String = screen._key_labels[id].text
			var panel: String = screen.hidden_observation(observation) if hidden.has(id) else screen.format_observation(observation, values.get(id))
			# A bar card (kid.bars: the push that started the box) draws a number as its bar, no text.
			var bar: Control = screen._key_bars.get(id)
			var number: bool = values.get(id) is float or values.get(id) is int
			var drawn: bool = card != "" if bar == null or not number else (bar.visible and card == "")
			same = same and card == screen.card_text(definition, observation, values.get(id), hidden.has(id)) and drawn \
				and screen._observation_labels[id].text == panel and not _kid_symbols.search(card)
			shown.append(card if card != "" else "(bar)")
		_expect(definition.camera.default_mode == "front" and screen.view.rig.mode == "front" and same and sidebar_fits and tip_clear \
			and definition.key_observations.size() >= 2 and definition.key_observations.size() <= 3,
			"%s: front camera, key cards %s = panel values in kid words (no unit symbol), the open sidebar keeps its width, the tip clears the actions and cards" % [definition.id, definition.key_observations],
			"%s; sidebar %.0f units" % [", ".join(shown), screen._sidebar.size.x])
		screen.queue_free()
		await process_frame
	host.queue_free()


## The gesture hint: short, shown only the first time an experiment opens in an app run, fades on
## the first gesture (no timer), never overlaps the cards or buttons; the sidebar keeps the full text.
func _check_gesture_tip() -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = TABLET_LANDSCAPE
	root.add_child(host)
	var screen_class: GDScript = load(EXPERIMENT_SCREEN)
	screen_class.reset_tips_shown()
	var definitions := ExperimentRegistry.load_all()
	var incline: Dictionary = {}
	var other: Dictionary = {}
	for definition in definitions:
		if definition.id == "incline-friction":
			incline = definition.duplicate(true)
		elif other.is_empty() and definition.get("tip_short", "") != "":
			other = definition.duplicate(true)
	# Dugi's question holds the hint back until it is answered (_check_tip_after_question): not here.
	incline.erase("predict")
	other.erase("predict")
	var first: Control = screen_class.new()
	first.setup(incline)
	host.add_child(first)
	for i in 3:
		await process_frame
	var tip: Label = first._tip
	var short_ok: bool = tip.visible and tip.text == ExperimentRegistry.kid_text(incline, "tip") and tip.text.length() < incline.tip.length() \
		and tip.get_line_count() <= 2 and tip.size.x <= 340.0
	var clear: bool = not tip.get_rect().intersects(first._action_row.get_rect()) and not tip.get_rect().intersects(first._key_row.get_rect()) \
		and not tip.get_rect().intersects(first._title_bar.get_rect()) and Rect2(Vector2.ZERO, first.view.size).encloses(tip.get_rect())
	var in_sidebar := _has_label_text(first._sidebar, incline.tip)
	_expect(short_ok and clear and in_sidebar,
		"gesture hint: first open shows a short (<=2 lines) hint clear of cards and buttons; the sidebar keeps the full text",
		"'%s' %d lines, width %.0f, clear %s, in sidebar %s" % [tip.text, tip.get_line_count(), tip.size.x, clear, in_sidebar])
	first.view.gesture_used.emit()
	for i in 40:
		await process_frame
	var faded: bool = not tip.visible
	first.queue_free()
	await process_frame
	var again: Control = screen_class.new()
	again.setup(incline)
	host.add_child(again)
	for i in 3:
		await process_frame
	again._set_control(incline.controls[0].id, again.experiment.control_value(incline.controls[0].id))
	again._fit_overlays()
	var hidden_again: bool = not again._tip.visible
	again.queue_free()
	await process_frame
	var fresh: Control = screen_class.new()
	fresh.setup(other)
	host.add_child(fresh)
	for i in 3:
		await process_frame
	var other_shown: bool = fresh._tip.visible
	# No timer (2026-10-31 user: the words went by too fast for a child): it stays until the child does it.
	for i in 60 * 10:
		await process_frame
	var stays: bool = fresh._tip.visible
	_expect(faded and hidden_again and other_shown and stays,
		"gesture hint: fades on the first gesture, is not shown again on re-entry or after a condition change, another experiment still shows its own once, and it stays until then (no timer)",
		"faded %s, again hidden %s, other shown %s, stays %s" % [faded, hidden_again, other_shown, stays])
	fresh.queue_free()
	await process_frame
	host.queue_free()


## While Dugi asks, the hint waits (hidden, not used up) and comes back once the question is answered
## (2026-10-31: before, the question hid it for good at once, so a child never saw it).
func _check_tip_after_question() -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = TABLET_LANDSCAPE
	root.add_child(host)
	var screen_class: GDScript = load(EXPERIMENT_SCREEN)
	screen_class.reset_tips_shown()
	var definition := ExperimentRegistry.find("incline-friction")
	var screen: Control = screen_class.new()
	screen.setup(definition)
	host.add_child(screen)
	for i in 5:
		await process_frame
	var hidden_while_asking: bool = screen._asking() and not screen._tip.visible
	screen._predict_pick_choice(str(MissionRound.predict(definition).get("answer", "")))
	for i in 60:   # Dugi's bridge opens, then is read (a tap)
		await process_frame
		if screen.dialogue.active:
			screen.dialogue.advance()
			screen.dialogue.advance()
	for i in 10:
		await process_frame
	var back: bool = screen._tip.visible and screen._tip.text != ""
	_expect(hidden_while_asking and back, "gesture hint: hidden while Dugi asks, shown once the question is answered and his box closed",
		"while asking hidden %s, after %s" % [hidden_while_asking, back])
	screen_class.reset_tips_shown()
	host.queue_free()
	await process_frame


## The hint counts as seen once it closed (the first gesture), not when the screen was built:
## a screen rebuilt before that (a condition change redraws it from the saved state) shows it again.
func _check_tip_rebuild() -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = TABLET_LANDSCAPE
	root.add_child(host)
	var screen_class: GDScript = load(EXPERIMENT_SCREEN)
	screen_class.reset_tips_shown()
	var definition := ExperimentRegistry.find("incline-friction").duplicate(true)
	definition.erase("predict")   # Dugi's question hides the hint at once (Plan G4): not under test here
	var first: Control = screen_class.new()
	first.setup(definition)
	host.add_child(first)
	for i in 3:
		await process_frame
	var shown_first: bool = first._tip.visible
	var state: Dictionary = first.capture_state()
	first.queue_free()
	await process_frame
	var second: Control = screen_class.new()
	second.setup(definition, state)
	host.add_child(second)
	for i in 3:
		await process_frame
	var shown_again: bool = second._tip.visible   # never closed before the rebuild
	second.view.gesture_used.emit()
	for i in 40:
		await process_frame
	var closed: bool = not second._tip.visible
	var state2: Dictionary = second.capture_state()
	second.queue_free()
	await process_frame
	var third: Control = screen_class.new()
	third.setup(definition, state2)
	host.add_child(third)
	for i in 3:
		await process_frame
	var hidden_after_seen: bool = not third._tip.visible
	_expect(shown_first and shown_again and closed and hidden_after_seen,
		"gesture hint: a screen rebuilt before the hint closed shows it again; once it closed, a rebuild does not",
		"first %s, rebuilt %s, closed %s, rebuilt after %s" % [shown_first, shown_again, closed, not hidden_after_seen])
	third.queue_free()
	await process_frame
	host.queue_free()


## The screen's "← 지도" button goes the way of Android back: an open sidebar closes first, the
## screen is left only when it is closed.
func _check_back_button() -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = TABLET_LANDSCAPE
	root.add_child(host)
	var screen: Control = load(EXPERIMENT_SCREEN).new()
	screen.setup(ExperimentRegistry.find("incline-friction"))
	host.add_child(screen)
	var left := [0]
	screen.back_requested.connect(func() -> void: left[0] += 1)
	for i in 3:
		await process_frame
	screen.open_sidebar(false)
	await process_frame
	screen._back_button.pressed.emit()
	var closed_first: bool = not screen.is_sidebar_open() and left[0] == 0
	for i in 30:
		await process_frame
	screen._back_button.pressed.emit()
	_expect(closed_first and left[0] == 1,
		"the 목록 button closes an open sidebar first, and leaves the screen when it is closed",
		"left after first press %s, after second %d" % [not closed_first, left[0]])
	host.queue_free()
	await process_frame


## Small windows (desktop): the title bar gives way to the top buttons instead of lying under them,
## with the sidebar open or closed.
func _check_small_window_title() -> void:
	var worst := ""
	for width in [700.0, 400.0, 300.0]:
		for open in [false, true]:
			var host := Control.new()
			host.theme = load(UI_THEME).build()
			host.size = Vector2(width, 720.0)
			root.add_child(host)
			var screen: Control = load(EXPERIMENT_SCREEN).new()
			screen.setup(ExperimentRegistry.find("incline-friction"))
			host.add_child(screen)
			for i in 3:
				await process_frame
			if open:
				screen.open_sidebar(false)
				for i in 3:
					await process_frame
			var bar: Rect2 = screen._title_bar.get_rect()
			var buttons: Rect2 = screen._top_buttons.get_rect()
			if bar.intersects(buttons) or bar.position.x < 0.0:
				worst += " %d%s: bar %s buttons %s" % [int(width), "+sidebar" if open else "", bar, buttons]
			host.queue_free()
			await process_frame
	_expect(worst == "", "small windows (700..300 units, sidebar open or closed): the title bar never overlaps the top buttons", worst)


func _has_label_text(node: Node, text: String) -> bool:
	if node is Label and (node as Label).text == text:
		return true
	for child in node.get_children():
		if _has_label_text(child, text):
			return true
	return false


## Horizontal field of view (degrees) of a View3D's camera.
func _horizontal_fov(view: Control) -> float:
	var rig: Camera3D = view.rig
	if rig.keep_aspect == Camera3D.KEEP_WIDTH:
		return rig.fov
	return rad_to_deg(2.0 * atan(tan(deg_to_rad(rig.fov) * 0.5) * view.size.x / view.size.y))


## Texts of every Button under `node`.
func _button_texts(node: Node) -> Array:
	var result := []
	for child in node.find_children("*", "Button", true, false):
		result.append(child.text)
	return result


## Launch args (--ctl-*, --camera) apply only to a screen that App opened with the flag.
func _check_launch_args_flag(definition: Dictionary) -> void:
	var quality_script: GDScript = load("res://scripts/core/quality.gd")
	var screen_script: GDScript = load(EXPERIMENT_SCREEN)
	var saved_args = quality_script.get("_args_cache")
	quality_script.set("_args_cache", PackedStringArray(["--ctl-angle=33", "--camera=top"]))
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = Vector2(1560, 720)
	root.add_child(host)
	var first: Control = screen_script.new()
	first.setup(definition, {}, true)
	host.add_child(first)
	await process_frame
	var second: Control = screen_script.new()
	second.setup(definition)
	host.add_child(second)
	await process_frame
	_expect(is_equal_approx(first.experiment.angle_deg, 33.0) and first.view.rig.mode == "top",
		"launch args apply to the screen opened with the flag", "angle %.1f, camera %s" % [first.experiment.angle_deg, first.view.rig.mode])
	_expect(not is_equal_approx(second.experiment.angle_deg, 33.0) and second.view.rig.mode != "top",
		"launch args do not apply to other experiment screens", "angle %.1f, camera %s" % [second.experiment.angle_deg, second.view.rig.mode])
	# A rebuilt screen restores conditions and camera (even with the flag set).
	first.experiment.set_control("angle", 12.0)
	first.view.rig.set_mode("side", true)
	var third: Control = screen_script.new()
	third.setup(definition, first.capture_state(), true)
	host.add_child(third)
	await process_frame
	_expect(is_equal_approx(third.experiment.angle_deg, 12.0) and third.view.rig.mode == "side",
		"a rebuilt screen keeps conditions and camera", "angle %.1f, camera %s" % [third.experiment.angle_deg, third.view.rig.mode])
	quality_script.set("_args_cache", saved_args)
	host.queue_free()


## The measured points reach the graph while the box slides, and a new run / reset clears them.
## The graph must be told to redraw each time the experiment's series grows.
func _check_graph_redraw(definition: Dictionary) -> void:
	var host := Control.new()
	host.theme = load(UI_THEME).build()
	host.size = Vector2(1560, 720)
	root.add_child(host)
	var screen: Control = load(EXPERIMENT_SCREEN).new()
	screen.setup(definition)
	host.add_child(screen)
	await process_frame
	var graph: GraphView = screen._graph
	var lab: Experiment = screen.experiment
	lab.set_control("angle", 40.0)
	lab.run_action("release")
	screen._refresh_left = 1000.0   # polled by hand below
	var sizes: Array[int] = []
	var redraws: Array[int] = []
	for i in 4:
		for j in 20:
			await physics_frame
		await process_frame   # a pending redraw is flushed
		screen._poll()
		redraws.append(graph.updates)
		sizes.append(graph.series.measured.size())
	_expect(sizes[3] > sizes[0] and sizes[0] >= 1 and redraws[3] > redraws[2] and redraws[2] > redraws[1],
		"graph gets new measured points and redraws while the box slides", "points %s, set_data calls %s" % [sizes, redraws])
	lab.run_action("reset")
	screen._poll()
	_expect(graph.series.measured.size() == 0, "reset clears the measured points on the graph", "%d" % graph.series.measured.size())
	# The contract of GraphView itself: the same array grown in place still redraws.
	var points := PackedVector2Array([Vector2.ZERO])
	graph.set_data({"measured": points})
	var drawn: int = graph.updates
	points.append(Vector2(1, 1))
	graph.set_data({"measured": points})
	_expect(graph.updates == drawn + 1, "GraphView.set_data redraws for data it already holds", "")
	host.queue_free()


## The wheel sends press and release: one notch zooms once.
func _check_wheel_zoom(definition: Dictionary) -> void:
	var view: Control = load(VIEW_3D).new()
	view.size = Vector2(720, 600)
	root.add_child(view)
	view.rig.configure(definition.camera)
	var before: float = view.rig.goal_distance
	view._gui_input(_mouse_button(MOUSE_BUTTON_WHEEL_UP, true))
	view._gui_input(_mouse_button(MOUSE_BUTTON_WHEEL_UP, false))
	var once: float = view.rig.goal_distance
	_expect(is_equal_approx(once, clampf(before * 0.9, view.rig.distance_range.x, view.rig.distance_range.y)),
		"one wheel notch zooms once (press only)", "%.3f -> %.3f" % [before, once])
	view.queue_free()


## The settings screen leaves a resume marker only when the tier change really restarts the app
## (Quality.needs_restart can say yes while set_tier decides not to restart).
func _check_settings_marker(_definition: Dictionary) -> void:
	var path := "user://resume.txt"
	var script: GDScript = load("res://scripts/app/settings_screen.gd")
	var outcomes := {}
	for restarts in [false, true]:
		DirAccess.remove_absolute(path)
		var screen: Control = script.new()
		screen.theme = load(UI_THEME).build()
		var on_disk := [false]
		screen.set_tier = func(_tier: String) -> bool:   # a restart can end the process inside it
			on_disk[0] = FileAccess.file_exists(path)
			return restarts
		root.add_child(screen)
		screen._select("medium" if root.get_node("Quality").tier != "medium" else "low")
		screen._apply_tier()
		outcomes[restarts] = FileAccess.file_exists(path) and on_disk[0]
		screen.queue_free()
	DirAccess.remove_absolute(path)
	_expect(not outcomes[false] and outcomes[true], "resume marker is written only when set_tier restarts the app", str(outcomes))


## Bench lines stay valid JSON for any scene name, and the signal carries scene and p95 itself.
func _check_bench_report() -> void:
	var bench: Node = root.get_node("Bench")
	var received := []
	var on_report := func(line: String, fps: float, scene: String, p95: float) -> void: received.append([line, fps, scene, p95])
	bench.report.connect(on_report)
	bench.reset('S3 "quoted"\\x')
	bench._frames = PackedFloat32Array([16.0, 16.0, 17.0, 40.0])
	bench._emit_window()
	bench.report.disconnect(on_report)
	var parsed: Variant = JSON.parse_string(received[0][0]) if received.size() == 1 else null
	_expect(parsed is Dictionary and parsed.scene == bench.scene_name and received[0][2] == bench.scene_name and is_equal_approx(received[0][3], parsed.p95ms),
		"OPBENCH line is valid JSON for a quoted scene name; signal carries scene and p95", received[0][0] if received.size() == 1 else "no report")
	bench.reset("list")
